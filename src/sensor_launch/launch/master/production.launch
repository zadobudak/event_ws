<?xml version="1.0"?>
<launch>
  <!-- Production Configuration: All sensors enabled for full operation -->
  
  <!-- Include the master launch with production-specific settings -->
  <include file="$(find sensor_launch)/launch/master/all_sensors.launch">
    <!-- Enable all sensors for production -->
    <arg name="enable_realsense" value="true" />
    <arg name="enable_velodyne" value="true" />
    <arg name="enable_xsens" value="true" />
    <arg name="enable_nmea" value="true" />
    <arg name="enable_dvs" value="true" />
    
    <!-- Production settings -->
    <arg name="robot_name" value="prod_robot" />
    <arg name="output" value="log" />
    <arg name="rviz" value="false" />
  </include>
  
  <!-- Production-specific nodes -->
  <node pkg="rosbag" type="record" name="sensor_recorder" 
        args="--all --duration=0 --split --size=1024 --output-prefix=/data/sensors/$(env ROS_NAMESPACE)_$(env ROS_HOSTNAME)_$(date +%Y%m%d_%H%M%S)" />
  
  <!-- Health monitoring -->
  <node pkg="diagnostic_aggregator" type="aggregator_node" name="diagnostic_aggregator" output="log">
    <rosparam command="load" file="$(find sensor_launch)/config/diagnostics.yaml" />
  </node>
  
</launch>
